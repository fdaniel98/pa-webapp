# --- Cliente (bundle público) ---
# La app corre como SPA estática, así que Vite sólo expone las variables con prefijo VITE_.
# Estas dos viajan al navegador: usa SIEMPRE la publishable/anon key, nunca la secret key.
VITE_SUPABASE_URL=xxx
VITE_SUPABASE_PUBLISHABLE_KEY=xxx

# --- Servidor / herramientas (nunca llegan al navegador) ---
SUPABASE_DB_PASSWORD=xxx
SUPABASE_URL=xxx
SUPABASE_PUBLISHABLE_KEY=xxx
SUPABASE_SECRET_KEY=xxx
SUPABASE_JWKS_URL=xxx
